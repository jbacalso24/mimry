# Test and benchmark fixtures are hashed and parsed byte-for-byte (see
# benchmark_input_digests / the determinism gates). A Windows checkout with
# core.autocrlf=true would rewrite their line endings and drift the digest and
# content-derived metrics, so pin them to LF on every platform.
benchmarks/fixtures/** text eol=lf
tests/fixtures/** text eol=lf

# makepkg reads PKGBUILD and its scripts as shell; CRLF breaks them.
packaging/aur/** text eol=lf

# The Claude Code plugin is generated and compared byte-for-byte by
# tests/test_plugin.py, so keep it LF on every platform.
plugins/** text eol=lf
.claude-plugin/** text eol=lf

# The changelog page is generated and compared byte-for-byte by
# tests/test_changelog_page.py, so keep it LF on every platform.
site/changelog/** text eol=lf
