{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jbacalso24/mimry",
  "title": "MIMRY",
  "description": "Finds the files a coding task touches, so your AI agent reads less. Local CLI and MCP server.",
  "websiteUrl": "https://jbacalso24.github.io/mimry/",
  "repository": {
    "url": "https://github.com/jbacalso24/mimry",
    "source": "github"
  },
  "version": "0.6.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "mimry",
      "version": "0.6.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
