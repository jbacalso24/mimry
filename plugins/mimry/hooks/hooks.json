{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--from",
              "mimry==0.6.2",
              "mimry",
              "hook-check"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--from",
              "mimry==0.6.2",
              "mimry",
              "hook-refresh"
            ],
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--from",
              "mimry==0.6.2",
              "mimry",
              "hook-refresh"
            ],
            "async": true
          }
        ]
      }
    ]
  }
}
