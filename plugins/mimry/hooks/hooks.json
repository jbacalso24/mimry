{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Bash|PowerShell|Glob|Grep|Read|mcp__(?:plugin_mimry_)?mimry__mimry_(?:brief|context|explain|find|history|preflight|related|route|semantic|why))$",
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--from",
              "mimry==0.8.4",
              "mimry",
              "hook-check"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--from",
              "mimry==0.8.4",
              "mimry",
              "hook-refresh"
            ],
            "async": true
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--from",
              "mimry==0.8.4",
              "mimry",
              "hook-compact"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--from",
              "mimry==0.8.4",
              "mimry",
              "hook-refresh"
            ],
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx",
            "args": [
              "--from",
              "mimry==0.8.4",
              "mimry",
              "hook-stop"
            ],
            "async": true
          }
        ]
      }
    ]
  }
}
